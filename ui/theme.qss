/* ReSonus — light, airy Qt stylesheet */

QWidget {
    font-family: "Segoe UI", "Inter", sans-serif;
    color: #33465c;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget#qt_scrollarea_viewport {
    background: transparent;
}

/* Shared slim scrollbar used by every module and recolored with the theme. */
QScrollBar:vertical {
    width: 10px;
    margin: 4px 2px 4px 2px;
    background: transparent;
}
QScrollBar::handle:vertical {
    min-height: 42px;
    background: #b8cde2;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #6fb1ea;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    height: 10px;
    margin: 2px 4px;
    background: transparent;
}
QScrollBar::handle:horizontal {
    min-width: 42px;
    background: #b8cde2;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background: #6fb1ea;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: transparent;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

QStackedWidget {
    background: transparent;
}

QWidget#WorkflowPage {
    background: #f4f9ff;
    border-radius: 16px;
}

QPushButton#GuidanceCloseButton {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    color: #2f6690;
    background: rgba(255,255,255,0.82);
    border: 1px solid #cfe1f2;
    border-radius: 8px;
    font-weight: 700;
}
QPushButton#GuidanceCloseButton:hover {
    background: #eaf4ff;
}

QFrame#AudioInputCard {
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid #d6e2ef;
    border-radius: 12px;
}

QFrame#AudioInputCard QLabel#SectionTitle {
    font-size: 14px;
}

QFrame#AudioInputCard QLabel#Caption {
    color: #6b7f96;
    line-height: 1.2em;
}

QMainWindow, #centralWidget {
    background: transparent;
}

/* ---- cards ---- */
.Card {
    background: rgba(255, 255, 255, 0.80);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 16px;
}

QLabel#TitleLabel {
    font-size: 22px;
    font-weight: 700;
    color: #2f3e50;
}
QLabel#SubtitleLabel {
    font-size: 12px;
    color: #6b7f96;
}
QLabel#SectionTitle {
    font-size: 16px;
    font-weight: 700;
    color: #2f3e50;
}
QLabel#Caption {
    font-size: 11px;
    color: #6b7f96;
}
QLabel#HintLabel {
    font-size: 11px;
    color: #8a9bb0;
    background: #f0f6fc;
    border-radius: 8px;
    padding: 6px 10px;
}
QLabel#ErrorLabel {
    color: #c0392b;
    font-size: 12px;
}
QLabel#SuccessLabel {
    color: #1e8a5f;
    font-size: 12px;
}

/* ---- inputs ---- */
QLineEdit {
    background: white;
    border: 1px solid #d6e2ef;
    border-radius: 10px;
    padding: 8px 10px;
    font-size: 13px;
    color: #33465c;
}
QLineEdit:focus {
    border: 1px solid #6fb1ea;
}

QComboBox {
    background: white;
    border: 1px solid #d6e2ef;
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 13px;
    color: #33465c;
}
QComboBox:focus {
    border: 1px solid #6fb1ea;
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background: white;
    color: #33465c;
    border: 1px solid #d6e2ef;
    selection-background-color: #6fb1ea;
    selection-color: white;
    outline: none;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #dbe8f4;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #6fb1ea;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::sub-page:horizontal {
    background: #8fd3c7;
    border-radius: 3px;
}
QSlider::groove:vertical {
    width: 6px;
    background: #dbe8f4;
    border-radius: 3px;
}
QSlider::handle:vertical {
    background: #6fb1ea;
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}
QSlider::add-page:vertical {
    background: #dbe8f4;
    border-radius: 3px;
}
QSlider::sub-page:vertical {
    background: #8fd3c7;
    border-radius: 3px;
}

QCheckBox {
    color: #33465c;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #d6e2ef;
    background: white;
}
QCheckBox::indicator:checked {
    background: #6fb1ea;
    border: 1px solid #6fb1ea;
}

/* ---- buttons ---- */
QPushButton {
    min-height: 32px;
    padding: 7px 14px;
    color: #2f6690;
    background: rgba(255,255,255,0.92);
    background-color: #ffffff;
    border: 1px solid #cfe1f2;
    border-radius: 9px;
    font-weight: 600;
}
QPushButton:hover {
    background: #eaf4ff;
}
QPushButton:pressed {
    background: #d9f0eb;
}
QPushButton:disabled {
    color: #8a9bb0;
    background: rgba(255,255,255,0.55);
    border-color: #dbe8f4;
}
QPushButton#PrimaryButton {
    background: #6fb1ea;
    background-color: #6fb1ea;
    color: #173f63;
    font-weight: 600;
    border: 1px solid #4f96cf;
    border-radius: 10px;
    padding: 9px 18px;
}
QPushButton#PrimaryButton:hover {
    background: #5fa3e0;
    background-color: #5fa3e0;
    color: #123650;
}
QPushButton#SecondaryButton {
    background: rgba(255,255,255,0.9);
    color: #2f6690;
    border: 1px solid #cfe1f2;
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton#SecondaryButton:hover {
    background: #eaf4ff;
}
QPushButton#SecondaryButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6fb1ea, stop:1 #8fd3c7);
    color: white;
    border: 1px solid transparent;
}
QPushButton#SliderStepButton {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    color: #2f6690;
    background: rgba(255,255,255,0.9);
    border: 1px solid #cfe1f2;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
}
QPushButton#SliderStepButton:hover {
    background: #eaf4ff;
}
QPushButton#SliderStepButton:pressed {
    background: #d9f0eb;
}
QPushButton#PlayButton {
    background: #eaf6f4;
    color: #2f6690;
    border: 1px solid #cdeae4;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: 600;
}
QPushButton#PlayButton:hover {
    background: #d9f0eb;
}

/* ---- tabs ---- */
QTabWidget::pane {
    border: none;
}
QTabBar::tab {
    background: transparent;
    padding: 8px 18px;
    color: #6b7f96;
    font-weight: 600;
}
QTabBar::tab:selected {
    color: #2f6690;
    border-bottom: 2px solid #6fb1ea;
}

/* ---- sidebar nav list ---- */
QListWidget#NavList {
    background: rgba(255, 255, 255, 0.55);
    border: none;
    border-radius: 14px;
    padding: 8px;
    font-size: 13px;
    outline: none;
}
QListWidget#NavList::item {
    padding: 10px 12px;
    border-radius: 10px;
    margin-bottom: 3px;
    color: #445872;
}
QListWidget#NavList::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6fb1ea, stop:1 #8fd3c7);
    color: white;
    font-weight: 600;
}
QListWidget#NavList::item:hover:!selected {
    background: #eaf4ff;
}

/* ---- sliders ---- */
QSlider::groove:horizontal {
    height: 6px;
    background: #dbe8f4;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #6fb1ea;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::sub-page:horizontal {
    background: #8fd3c7;
    border-radius: 3px;
}

/* ---- pill badges ---- */
QLabel.Pill {
    background: #e7f3ff;
    color: #2f6690;
    font-size: 11px;
    font-weight: 600;
    border-radius: 10px;
    padding: 4px 10px;
}
